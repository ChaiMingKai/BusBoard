<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arrival_cell" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:orientation="vertical" android:gravity="center"
    android:importantForAccessibility="yes">
    <TextView android:id="@+id/eta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:includeFontPadding="false" android:singleLine="true"
        android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum"
        android:textColor="#FFFFFF" android:textSize="18sp" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="17dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/deck" android:layout_width="23dp" android:layout_height="16dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no"/>
        <ImageView android:id="@+id/crowd" android:layout_width="17dp" android:layout_height="17dp"
            android:layout_marginLeft="4dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    </LinearLayout>
</LinearLayout>
