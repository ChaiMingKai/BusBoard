<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/separator" android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#36584D" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
            android:textColor="#CEDECF" android:textSize="11sp"/>
        <LinearLayout android:id="@+id/arrivals" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:baselineAligned="false" android:gravity="center_vertical">
            <TextView android:id="@+id/service" android:layout_width="51dp" android:layout_height="24dp"
                android:gravity="center" android:singleLine="true" android:includeFontPadding="false"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#123D34" android:background="@drawable/line_bg"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
